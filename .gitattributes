# 统一换行符，避免 Windows 下 diff 全红
* text=auto

*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.kt   text eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.apk  binary
*.woff2 binary

# 部署套件是 Linux 上直接 bash 跑的，必须是 LF（Windows 默认 autocrlf 会写出 CRLF 版）
*.sh       text eol=lf
*.conf     text eol=lf
*.service  text eol=lf
