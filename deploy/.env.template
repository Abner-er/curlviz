# CurlViz Agent 环境变量
# 安装到 /etc/curlviz/.env，systemd 单元通过 EnvironmentFile 加载
# 修改后需 systemctl restart curlviz-agent

# ─── 必填 ─────────────────────────────────────────────────────────────────────

# 鉴权 token：前端"执行机管理"里填同一个值（只存浏览器会话内存，刷新需重填）
# 生成方式：openssl rand -hex 32
CURLVIZ_TOKEN=

# SSRF 白名单：逗号分隔，允许 agent 访问的主机名 / IP / CIDR
# 例：internal.api,*.svc.cluster.local,10.0.0.0/8
# 不要写 0.0.0.0/0（等于没闸门）
CURLVIZ_ALLOW=

# ─── 可选 ─────────────────────────────────────────────────────────────────────

# agent 监听端口（默认 8788，nginx 反代写死了 127.0.0.1:8788，改这里需同步改 nginx）
CURLVIZ_PORT=8788

# 允许的 Origin（逗号分隔），配了才校验；同源部署（nginx 反代）可不填
# 例：https://curlviz.example.com
CURLVIZ_ALLOWED_ORIGINS=

# 单条 curl 最大执行时长（毫秒，默认 60000）
CURLVIZ_MAX_TIME_MS=60000

# 最大并发 curl 进程数（默认 8）
CURLVIZ_MAX_CONCURRENCY=8

# 每分钟最大请求数（滑动窗口，拒绝请求也计数，默认 30）
CURLVIZ_RATE_PER_MIN=30
